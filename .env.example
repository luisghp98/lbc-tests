# Copia este archivo a `.env` y rellena los valores.
# El `.env` está en .gitignore: nunca lo subas.
#
# Para apuntar la suite a OTRO COLEGIO basta con cambiar USER y PASSWORD.
# El school_id, el campus y el aula se resuelven solos desde la sesión de ese
# usuario (ver e2e/utils/school.ts). No hay UUIDs quemados en los tests.

# ---- Credenciales de la suite (lo único que normalmente cambias) ----
USER=usuario@ejemplo.com
PASSWORD=

# ---- Entorno ----
BASE_URL=https://prelbc.juvomos.com
API_BASE_URL=https://api.presupbase.juvomos.com
API_KEY=

# Multiplica todos los timeouts de Playwright. Súbelo si el ambiente va lento.
TIMEOUT_FACTOR=4

# Activa los logs de debugLog().
DEBUG=true

# ---- Opcional: sólo si USER tiene acceso a VARIOS colegios ----
# Normalmente déjalos vacíos. Si los defines, mandan sobre la autodetección.
# SCHOOL_ID=
# CAMPUS_ID=

# ---- Matriz de roles (e2e/tests/permissions/login-by-role.spec.ts) ----
TEST_USER_PASSWORD=
TEST_USER_SUPER_ADMIN=
TEST_USER_SUPER_ADMIN_PASSWORD=
TEST_USER_ORGANIZATION_ADMIN=
TEST_USER_ORGANIZATION_ADMIN_PASSWORD=
TEST_USER_ACCOUNTANT=
TEST_USER_RECEPCIONIST=
TEST_USER_SCHOOL_ADMIN=
TEST_USER_PRINCIPAL=
TEST_USER_ASSISTANT_TEACHER=
TEST_USER_PARENT_GUARDIAN=
TEST_USER_STAFF=
TEST_USER_STAFF2=
TEST_USER_STAFF3=
TEST_USER_TEACHER=
TEST_USER_CUSTOM_ROLE=
TEST_USER_PARENT=
